<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>sharpYoinkerAPP</RootNamespace>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use platform-specific APIs, use conditional compilation.
    See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
	<DebugType>none</DebugType>
	<DebugSymbols>false</DebugSymbols>
	<ApplicationIcon>Assets\favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\sharpYoinkerAPP\sharpYoinkerAPP.csproj" />
  </ItemGroup>

	<ItemGroup>
	    <None Update="tools\yt-dlp.exe" TargetPath="yt-dlp.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

	    <None Update="tools\ffmpeg.exe" TargetPath="ffmpeg.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

	    <None Update="tools\ffprobe.exe" TargetPath="ffprobe.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />

		<None Update="tools\deno.exe" TargetPath="deno.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
	</ItemGroup>
	
</Project>
